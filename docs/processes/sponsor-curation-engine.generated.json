  "reviewGates": [
    {
      "id": "qualification_review",
      "requiredBeforeStage": "qualified",
      "owner": "research_owner",
      "rule": "Confirm at least one AI relevance signal and one event behavior signal, unless a trusted referral override is documented."
    },
    {
      "id": "outreach_approval",
      "requiredBeforeStage": "outreach_ready",
      "owner": "mojo_owner",
      "rule": "Confirm trust fit, category fit, owner assignment, contact map, and message angle before first outreach."
    },
    {
      "id": "proposal_approval",
      "requiredBeforeStage": "proposal",
      "owner": "mojo_owner",
      "rule": "Confirm proposed partner role, sponsor boundaries, deliverables, pricing, data access rules, and event-fit rationale."
    }
  ],
  "recommendedMvp": {
    "phase": "spreadsheet_backed_tracker",
    "seedTargetCompanies": 250,
    "priorityThreshold": 75,
    "trackerTemplatePath": "docs/processes/sponsor-curation-tracker-template.csv",
    "scoringScriptPath": "scripts/score-sponsor-prospects.mjs",
    "weeklyReviewCadence": "weekly",
    "humanApprovalRequiredBeforeFirstOutreach": true
