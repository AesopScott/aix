{
  "name": "mojo-ai-summits",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-25",
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "MOJO_SUMMITS_SETUP_STATE",
      "id": "90f60403fcf2469987cec51bdc3cde72"
    }
  ],
  "d1_databases": [
    {
      "binding": "MOJO_SUMMITS_DB",
      "database_name": "mojo-ai-summits-crm",
      "database_id": "051e7ac1-dc58-4f8f-9646-dd481c284e49",
      "migrations_dir": "migrations/crm"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MOJO_SUMMITS_STORAGE",
      "bucket_name": "mojo-summits-private"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
