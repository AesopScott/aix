{
  "name": "mojo-ai-summits-invite-email",
  "main": "workers/invite-email.js",
  "compatibility_date": "2026-07-25",
  "kv_namespaces": [
    {
      "binding": "MOJO_SUMMITS_SETUP_STATE",
      "id": "90f60403fcf2469987cec51bdc3cde72"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "angel@mojoaisummits.com",
        "scott@mojoaisummits.com"
      ],
      "allowed_sender_addresses": [
        "noreply@mojoaisummits.com"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "mojoaisummits.com/api/invite-request*",
      "zone_id": "b910728a7afc7c48a9ff5bf52f668631"
    },
    {
      "pattern": "www.mojoaisummits.com/api/invite-request*",
      "zone_id": "b910728a7afc7c48a9ff5bf52f668631"
    }
  ]
}
